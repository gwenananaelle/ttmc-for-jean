{
    "$id": "https://example.com/quiz-cards.json",
    "title": "TTMC for Jean",
    "description": "A collection of quiz cards covering various famous Jean",
    "type": "object",
    "properties": {
        "cards": {
            "type": "array",
            "description": "An array contains all possible questions cards (in no specific order)",
            "items": {
                "type": "object",
                "properties": {
                    "theme": {
                        "type": "string",
                        "title": "Theme",
                        "description": "The theme covered by the questions of this card"
                    },
                    "category": {
                        "type": "string",
                        "enum": ["livre", "divers", "musique", "cinema", "challenge"],
                        "title": "Category",
                        "description": "One of the 5 categories in which this theme fits"
                    },
                    "instructions": {
                        "type": "string",
                        "title": "Instructions",
                        "description": "How to answer the challenge"
                    },
                    "questions": {
                        "type": "array",
                        "title": "Questions",
                        "description": "The 10 questions of the card",
                        "minItems": 0,
                        "maxItems": 10,
                        "items": {"type": "string", "maxLength": 160}
                    },
                    "answers": {
                        "type": "array",
                        "title": "Answers",
                        "description": "The answer of each question (in the same order)",
                        "minItems": 0,
                        "maxItems": 10,
                        "items": {"type": "string", "maxLength": 160}
                    }
                },
                "required": ["theme", "category"]
            }
        }
    },
    "required": ["cards"]
}
